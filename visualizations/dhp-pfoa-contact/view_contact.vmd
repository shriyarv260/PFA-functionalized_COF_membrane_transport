# Proposed contact only; source and limitations in model_notes.json.
foreach mid [molinfo list] {mol off $mid}
# Embedded coordinates make this state independent of its download location.
set visualtmp [pwd]
foreach visualkey {TMPDIR TEMP TMP} {if {[info exists env($visualkey)] && [file isdirectory $env($visualkey)]} {set visualtmp $env($visualkey); break}}
set visualpath [file join $visualtmp "pfas_visual_[pid]_[clock clicks].pdb"]
set visualchannel [open $visualpath {WRONLY CREAT EXCL}]
