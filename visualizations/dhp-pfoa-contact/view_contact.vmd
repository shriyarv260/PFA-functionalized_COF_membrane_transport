close $visualchannel
set contactid [mol new $visualpath type pdb waitfor all]
file delete $visualpath
mol rename $contactid "Illustrative DHP fragment + neutral PFOA"
mol modstyle 0 $contactid Licorice 0.17 16 16
mol modcolor 0 $contactid ColorID 6
mol modselect 0 $contactid resname DHF
mol representation CPK 0.65 0.18 20 20
mol color Name
mol selection resname PFO
mol addrep $contactid
mol representation CPK 0.7 0.18 20 20
mol color ColorID 1
mol selection "index 3"
mol addrep $contactid
graphics $contactid color yellow
graphics $contactid cylinder {0.20 0 0} {0.36 0 0} radius 0.045 filled yes
graphics $contactid cylinder {0.50 0 0} {0.66 0 0} radius 0.045 filled yes
graphics $contactid cylinder {0.80 0 0} {0.96 0 0} radius 0.045 filled yes
graphics $contactid cylinder {1.10 0 0} {1.26 0 0} radius 0.045 filled yes
graphics $contactid cylinder {1.40 0 0} {1.56 0 0} radius 0.045 filled yes
graphics $contactid color white
graphics $contactid text {-2 3 0} "Proposed H...O: 1.90 A" size 1.0
graphics $contactid text {-8.07 -6 0} "DHP fragment" size 1.0
graphics $contactid text {1.90 -6 0} "PFOA acid" size 1.0
color Display Background black
display projection Orthographic
axes location Off
display resetview
scale by 0.8
