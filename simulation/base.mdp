; Preparation template, requiring validated topology and ensemble choice.
integrator = md
dt = 0.002
nsteps = 10000000
continuation = yes
constraints = h-bonds
constraint-algorithm = lincs
cutoff-scheme = Verlet
rlist = 1.2
coulombtype = PME
rcoulomb = 1.2
vdwtype = Cut-off
rvdw = 1.2
tcoupl = V-rescale
tc-grps = System
tau-t = 1.0
ref-t = 298.15
pcoupl = no
pbc = xyz
gen-vel = no
nstxout-compressed = 500
nstenergy = 500
nstlog = 500
